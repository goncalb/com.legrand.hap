  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Heating profile changed"
        },
        "tokens": [
          {
            "name": "profile",
            "type": "string",
            "title": {
              "en": "Profile"
            },
            "example": "comfort"
          },
          {
            "name": "previous",
            "type": "string",
            "title": {
              "en": "Previous profile"
            },
            "example": "eco"
          }
        ],
        "args": [],
        "id": "heating_profile_changed"
      },
      {
        "title": {
          "en": "A button is pressed"
        },
        "titleFormatted": {
          "en": "Button [[button]] is pressed"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=remote"
          },
          {
            "type": "dropdown",
            "name": "button",
            "title": {
              "en": "Button"
            },
            "values": [
              {
                "id": "1",
                "title": {
                  "en": "Button 1"
                }
              },
              {
                "id": "2",
                "title": {
                  "en": "Button 2"
                }
              },
              {
                "id": "3",
                "title": {
                  "en": "Button 3"
                }
              },
              {
                "id": "4",
                "title": {
                  "en": "Button 4"
                }
              }
            ]
          }
        ],
        "id": "remote_button_pressed"
      },
      {
        "title": {
          "en": "Heating started or stopped"
        },
        "titleFormatted": {
          "en": "Heating [[state]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          },
          {
            "type": "dropdown",
            "name": "state",
            "title": {
              "en": "State"
            },
            "values": [
              {
                "id": "on",
                "title": {
                  "en": "started"
                }
              },
              {
                "id": "off",
                "title": {
                  "en": "stopped"
                }
              }
            ]
          }
        ],
        "id": "thermostat_heating_changed"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "Heating profile !{{is|isn't}}"
        },
        "titleFormatted": {
          "en": "Heating profile !{{is|isn't}} [[profile]]"
        },
        "args": [
          {
            "type": "dropdown",
            "name": "profile",
            "title": {
              "en": "Profile"
            },
            "values": [
              {
                "id": "comfort",
                "title": {
                  "en": "Comfort"
                }
              },
              {
                "id": "eco",
                "title": {
                  "en": "Eco"
                }
              },
              {
                "id": "night",
                "title": {
                  "en": "Night"
                }
              },
              {
                "id": "away",
                "title": {
                  "en": "Away"
                }
              },
              {
                "id": "frost",
                "title": {
                  "en": "Frost guard"
                }
              }
            ]
          }
        ],
        "id": "heating_profile_is"
      },
      {
        "title": {
          "en": "Shutter !{{is|isn't}} moving"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=shutter"
          }
        ],
        "id": "shutter_is_moving"
      },
      {
        "title": {
          "en": "Thermostat !{{is|isn't}} heating"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          }
        ],
        "id": "thermostat_is_heating"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Resume heating plan"
        },
        "hint": {
          "en": "Cancels any override and manual room holds; the plan takes over again."
        },
        "args": [],
        "id": "heating_resume"
      },
      {
        "title": {
          "en": "Set heating profile"
        },
        "titleFormatted": {
          "en": "Set heating to [[profile]] [[duration]]"
        },
        "hint": {
          "en": "Overrides the house heating plan for all rooms that follow it."
        },
        "args": [
          {
            "type": "dropdown",
            "name": "profile",
            "title": {
              "en": "Profile"
            },
            "values": [
              {
                "id": "comfort",
                "title": {
                  "en": "Comfort"
                }
              },
              {
                "id": "eco",
                "title": {
                  "en": "Eco"
                }
              },
              {
                "id": "night",
                "title": {
                  "en": "Night"
                }
              },
              {
                "id": "away",
                "title": {
                  "en": "Away"
                }
              },
              {
                "id": "frost",
                "title": {
                  "en": "Frost guard"
                }
              }
            ]
          },
          {
            "type": "dropdown",
            "name": "duration",
            "title": {
              "en": "Duration"
            },
            "values": [
              {
                "id": "next",
                "title": {
                  "en": "until the next switch point"
                }
              },
              {
                "id": "1",
                "title": {
                  "en": "for 1 hour"
                }
              },
              {
                "id": "2",
                "title": {
                  "en": "for 2 hours"
                }
              },
              {
                "id": "4",
                "title": {
                  "en": "for 4 hours"
                }
              },
              {
                "id": "8",
                "title": {
                  "en": "for 8 hours"
                }
              },
              {
                "id": "24",
                "title": {
                  "en": "for 24 hours"
                }
              },
              {
                "id": "forever",
                "title": {
                  "en": "until cancelled"
                }
              }
            ]
          }
        ],
        "id": "heating_set_profile"
      },
      {
        "title": {
          "en": "Activate a scene"
        },
        "titleFormatted": {
          "en": "Activate scene [[scene]]"
        },
        "hint": {
          "en": "Scenes are defined in the app settings (Scenes tab)."
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "scene",
            "title": {
              "en": "Scene"
            },
            "placeholder": {
              "en": "Choose a scene"
            }
          }
        ],
        "id": "scene_activate"
      },
      {
        "title": {
          "en": "Set slat angle"
        },
        "titleFormatted": {
          "en": "Set slats to [[angle]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=shutter&capabilities=shutter_tilt"
          },
          {
            "type": "range",
            "name": "angle",
            "title": {
              "en": "Slat angle"
            },
            "min": 0,
            "max": 88,
            "step": 22,
            "label": "°",
            "labelMultiplier": 1,
            "labelDecimals": 0
          }
        ],
        "id": "shutter_set_tilt"
      },
      {
        "title": {
          "en": "Set position and slat angle"
        },
        "titleFormatted": {
          "en": "Set position to [[position]] and slats to [[angle]]"
        },
        "hint": {
          "en": "Moves the shutter to the position first, then sets the slat angle once it has stopped."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=shutter&capabilities=shutter_tilt"
          },
          {
            "type": "range",
            "name": "position",
            "title": {
              "en": "Position"
            },
            "min": 0,
            "max": 100,
            "step": 1,
            "label": "%",
            "labelMultiplier": 1,
            "labelDecimals": 0
          },
          {
            "type": "range",
            "name": "angle",
            "title": {
              "en": "Slat angle"
            },
            "min": 0,
            "max": 88,
            "step": 22,
            "label": "°",
            "labelMultiplier": 1,
            "labelDecimals": 0
          }
        ],
        "id": "shutter_set_tilt_and_position"
      }
    ]
  },
