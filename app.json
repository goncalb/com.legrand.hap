    "homey:manager:api"
  ],
  "author": {
    "name": "Community developer"
  },
  "api": {
    "getLog": {
      "method": "GET",
      "path": "/log"
    },
    "clearLog": {
      "method": "POST",
      "path": "/log/clear"
    },
    "getDevices": {
      "method": "GET",
      "path": "/devices"
    },
    "identify": {
      "method": "POST",
      "path": "/identify"
    },
    "refresh": {
      "method": "POST",
      "path": "/refresh"
    },
    "setName": {
      "method": "POST",
      "path": "/device-name"
    },
    "listEndpoints": {
      "method": "GET",
      "path": "/endpoints"
    },
    "importPairing": {
      "method": "POST",
      "path": "/endpoint-import"
    },
    "pairDevice": {
      "method": "POST",
      "path": "/endpoint-pair"
    },
    "removeEndpoint": {
      "method": "POST",
      "path": "/endpoint-remove"
    },
    "setEndpointAddress": {
      "method": "POST",
      "path": "/endpoint-address"
    },
    "captureScene": {
      "method": "GET",
      "path": "/scene-capture"
    },
    "runScene": {
      "method": "POST",
      "path": "/scene-run"
    },
    "getScenes": {
      "method": "GET",
      "path": "/scene-list"
    },
    "saveScenes": {
      "method": "POST",
      "path": "/scene-save"
    },
    "getHeating": {
      "method": "GET",
      "path": "/heating"
    },
    "saveHeating": {
      "method": "POST",
      "path": "/heating-save"
