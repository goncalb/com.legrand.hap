{
  "name": {
    "en": "Shutter"
  },
  "class": "windowcoverings",
  "capabilities": [
    "shutter_status",
    "windowcoverings_set",
    "windowcoverings_state",
    "shutter_moving",
    "button.identify",
    "button.rebuild",
    "button.reset_travel"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png"
  },
  "pair": [
    {
      "id": "setup"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Device information"
      },
      "children": [
        {
          "id": "serial",
          "type": "label",
          "label": {
            "en": "Serial number"
          },
          "value": ""
        },
        {
          "id": "model",
          "type": "label",
          "label": {
            "en": "Model"
          },
          "value": ""
        },
        {
          "id": "firmware",
          "type": "label",
          "label": {
            "en": "Firmware"
          },
          "value": ""
        },
        {
          "id": "tilt",
          "type": "label",
          "label": {
            "en": "Slat tilt (Orientable mode)"
          },
          "value": ""
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Travel times (used by the Shutters widget animation)"
      },
      "children": [
        {
          "id": "travel_up",
          "type": "label",
          "label": {
            "en": "Learned: full travel up"
          },
          "value": "not learned yet"
        },
        {
          "id": "travel_down",
          "type": "label",
          "label": {
            "en": "Learned: full travel down"
          },
          "value": "not learned yet"
        },
        {
          "id": "travel_up_manual",
          "type": "number",
          "label": {
            "en": "Manual: full travel up (s)"
          },
          "value": 0,
          "min": 0,
          "max": 300,
          "units": {
            "en": "s"
          },
          "hint": {
            "en": "Seconds for a full 0 → 100 % travel. 0 = use the learned value above. A manual value takes precedence and pauses learning for this direction."
          }
        },
        {
          "id": "travel_down_manual",
          "type": "number",
          "label": {
            "en": "Manual: full travel down (s)"
          },
          "value": 0,
          "min": 0,
          "max": 300,
          "units": {
            "en": "s"
          },
          "hint": {
            "en": "Seconds for a full 100 → 0 % travel. 0 = use the learned value above. Orientable shutters cannot be timed on a full close (the gateway reports the position only after the slats have re-opened), so set the time here if learning gives a value that is too high."
          }
        }
      ]
    }
  ],
  "capabilitiesOptions": {
    "windowcoverings_tilt_set": {
      "uiComponent": null
    },
    "button.identify": {
      "maintenanceAction": true,
      "title": {
        "en": "Blink the wall module"
      },
      "desc": {
        "en": "The module's LED will blink so you can identify it."
      }
    },
    "shutter_status": {
      "uiComponent": null,
      "title": {
        "en": "Status"
      }
    },
    "button.rebuild": {
      "maintenanceAction": true,
      "title": {
        "en": "Rebuild device capabilities"
      },
      "desc": {
        "en": "Re-creates this device's controls from the gateway data. Use if the device looks empty or out of date after an app update."
      }
    },
    "button.reset_travel": {
      "maintenanceAction": true,
      "title": {
        "en": "Reset learned travel times"
      },
      "desc": {
        "en": "Forget the measured travel times (e.g. after a motor replacement). Learning starts again from the next runs."
      }
    },
    "windowcoverings_state": {
      "uiComponent": null,
      "title": {
        "en": "Direction"
      }
    }
  }
}